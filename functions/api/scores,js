export async function onRequestGet(context) {
    const { env } = context;

    try {
        // En yüksek 30 Net WPM skorunu veritabanından çek
        const { results } = await env.DB.prepare(
            "SELECT id, name, net_wpm as netWpm, gross_wpm as grossWpm, accuracy, duration, created_at FROM scores ORDER BY net_wpm DESC, accuracy DESC, gross_wpm DESC LIMIT 30"
        ).all();

        return new Response(JSON.stringify(results), {
            headers: {
                "Content-Type": "application/json",
                "Cache-Control": "no-store"
            }
        });
    } catch (err) {
        return new Response(JSON.stringify({ error: "Skorlar yüklenemedi." }), {
            status: 500,
            headers: { "Content-Type": "application/json" }
        });
    }
}

export async function onRequestPost(context) {
    const { request, env } = context;

    try {
        // 1. İstek kaynağını kontrol et (Sadece kendi sitenizden gelen isteklere izin verin)
        const origin = request.headers.get("Origin") || "";
        const host = request.headers.get("Host") || "";
        if (origin && !origin.includes(host)) {
            return new Response(JSON.stringify({ error: "Yetkisiz erişim kaynağı." }), { status: 403 });
        }

        const body = await request.json();
        const { name, netWpm, grossWpm, accuracy, duration, finalChars, correctCount, wrongCount, elapsedMs } = body;

        // 2. Temel veri tipi ve zorunluluk kontrolleri
        const cleanName = String(name || "Misafir").trim().slice(0, 24);
        const validDurations = [15, 30, 60, 120];

        if (!validDurations.includes(Number(duration))) {
            return new Response(JSON.stringify({ error: "Geçersiz test süresi." }), { status: 400 });
        }

        if (
            typeof netWpm !== "number" || typeof grossWpm !== "number" ||
            typeof accuracy !== "number" || typeof finalChars !== "number" ||
            typeof correctCount !== "number" || typeof wrongCount !== "number"
        ) {
            return new Response(JSON.stringify({ error: "Eksik veya hatalı veri formatı." }), { status: 400 });
        }

        // 3. Süre ve Gerçekçilik Doğrulaması (Hile Koruması)
        // Test süresi gerçekten dolmuş mu? (En az süre - 1.5 saniye tolerans)
        const minRequiredMs = (duration * 1000) - 1500;
        if (!elapsedMs || elapsedMs < minRequiredMs) {
            return new Response(JSON.stringify({ error: "Test süresi tamamlanmadan skor gönderildi." }), { status: 400 });
        }

        // İnsani hız sınırları ve matematiksel tutarlılık kontrolü
        const minutes = duration / 60;
        const expectedGrossWpm = Math.round((finalChars / 5) / minutes);
        const expectedNetWpm = Math.max(0, Math.round(expectedGrossWpm - (wrongCount / minutes)));

        if (Math.abs(grossWpm - expectedGrossWpm) > 2 || Math.abs(netWpm - expectedNetWpm) > 2) {
            return new Response(JSON.stringify({ error: "Skor hesaplama tutarsızlığı tespit edildi." }), { status: 400 });
        }

        // 220 WPM üzeri insanüstü/bot hızları engelle
        if (netWpm < 0 || netWpm > 220 || accuracy < 0 || accuracy > 100) {
            return new Response(JSON.stringify({ error: "Değerler geçerli aralık dışında." }), { status: 400 });
        }

        // 4. Veritabanına Kaydet
        const info = await env.DB.prepare(
            "INSERT INTO scores (name, net_wpm, gross_wpm, accuracy, duration) VALUES (?, ?, ?, ?, ?)"
        ).bind(cleanName, netWpm, grossWpm, accuracy, duration).run();

        const insertedId = info.meta?.last_row_id || null;

        // Güncel ilk 30 listesini geri döndür
        const { results } = await env.DB.prepare(
            "SELECT id, name, net_wpm as netWpm, gross_wpm as grossWpm, accuracy, duration FROM scores ORDER BY net_wpm DESC, accuracy DESC, gross_wpm DESC LIMIT 30"
        ).all();

        return new Response(JSON.stringify({
            success: true,
            insertedId,
            scores: results
        }), {
            headers: { "Content-Type": "application/json" }
        });

    } catch (err) {
        return new Response(JSON.stringify({ error: "Sunucu hatası oluştu." }), {
            status: 500,
            headers: { "Content-Type": "application/json" }
        });
    }
}